# Backend Environment Variables
# Copy this file to .env and fill in actual values.

# MongoDB Atlas (Primary Operational Database)
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=ElectionCluster
MONGODB_DB_NAME=election_db

# Security & JWT
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ENVIRONMENT=production

# Supabase PostgreSQL (Electoral Records & Data Sync)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary Storage (Persistent Original Excel & PDF Storage)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Redis Cache (Optional for Performance & Session Optimization)
# If left empty, application works in direct fast database mode seamlessly.
REDIS_URL=redis://localhost:6379/0
