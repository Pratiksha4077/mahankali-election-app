# ==========================================
# Election App - Root Git Ignore
# ==========================================

# --------------------------
# Environment / Secrets
# --------------------------
.env
.env.*
!.env.example
*.env

# --------------------------
# Node.js / React / Expo
# --------------------------
node_modules/
.expo/
dist/
build/
web-build/
.metro/
.metro-health-check*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --------------------------
# React Native / Expo Native
# --------------------------
/android/
/frontend/android/
/ios/
/frontend/ios/
!frontend/modules/**/android/
!frontend/modules/**/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# --------------------------
# Python
# --------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
ENV/
.venv/
*.egg-info/

# --------------------------
# Local databases
# --------------------------
*.db
*.sqlite
*.sqlite3

# --------------------------
# Backend generated data
# --------------------------
backend/uploads/*
backend/processed/*
backend/exports/*

# Keep folders available in Git
!backend/uploads/.gitkeep
!backend/processed/.gitkeep
!backend/exports/.gitkeep

# --------------------------
# IDE
# --------------------------
.vscode/
.idea/
*.swp
*.swo

# --------------------------
# OS
# --------------------------
.DS_Store
Thumbs.db
desktop.ini

# --------------------------
# Logs
# --------------------------
*.log

# --------------------------
# Temporary files
# --------------------------
*.tmp
*.temp